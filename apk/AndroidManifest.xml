<?xml version="1.0" encoding="utf-8"?>
<!--
  注意：versionCode / versionName 不写在这里，由 build.sh 从 version.env 读取后
  通过 aapt2 的版本参数注入，实现「每次打包自动 +1」。
  android:label 同理由 build.sh 用 sed 注入桌面名（EV 变体 = 「Ev课程表」，EvBox 变体 = 「EvBox Sync」）。
  桌面名不带版本号：版本号只在 App 内首页展示，避免每次升级桌面名都变。
  注意：XML 注释里不能出现两个连续的短横线。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.application.watch.classschedule">

    <!-- 官方 interconnect 要求：包名必须与快应用 manifest.json 的 package 完全一致。
         也正因如此，包名不能带版本号，版本号只体现在文件名与 android:label 上。 -->
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- Android 11+ 包可见性：必须能让 SDK 看到「小米穿戴 / 小米运动健康」App（来自 AAR 自身声明） -->
    <queries>
        <package android:name="com.xiaomi.wearable" />
        <package android:name="com.mi.health" />
        <!-- 打赏页「打开」微信/支付宝：Android 11+ 必须声明可见性，否则 resolveActivity / getLaunchIntentForPackage 返回 null -->
        <package android:name="com.tencent.mm" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="wxp" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="alipays" />
        </intent>
    </queries>

    <!-- 留言提醒：震动；Android 13+ 通知（后续做后台提醒时需要） -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 快速激活（换 18 位激活码）与埋点上报需要联网 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 常驻前台服务：进程活着才能在后台收到手环推来的留言（不轮询） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 省电白名单引导：申请「忽略电池优化」 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 上课提醒：精确定时（Android 12+ 需用户授予；未授予时降级 ±1 分钟） + 开机后补排 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- App 自动升级（PackageInstaller 自装自更）：Android 8+ 必需，安装时系统仍会弹用户确认 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="EV Sync"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false"
        android:roundIcon="@drawable/ic_launcher"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:windowSoftInputMode="stateAlwaysHidden">

        <!-- 构建变体：由 build.sh 在打包时替换占位符（一套源码 → 两个包名的 APK） -->
        <meta-data android:name="ev.variant" android:value="__VARIANT__" />
        <meta-data android:name="ev.peer_pkg" android:value="__PEER_PKG__" />

        <activity
            android:name="com.application.watch.classschedule.HomeActivity"
            android:exported="true"
            android:windowSoftInputMode="stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 内部页面也 exported=true：方便 adb shell am start 直达做回归/UED 验证
             （无 intent-filter，外部只能按类名显式唤起；自用工具，可接受）。 -->
        <activity android:name="com.application.watch.classschedule.MessageActivity"
            android:exported="true"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />
        <activity android:name="com.application.watch.classschedule.DebugActivity"
            android:exported="true"
            android:windowSoftInputMode="stateAlwaysHidden" />
        <activity android:name="com.application.watch.classschedule.SettingsActivity"
            android:exported="true"
            android:windowSoftInputMode="stateAlwaysHidden" />
        <activity android:name="com.application.watch.classschedule.TransferActivity"
            android:exported="true"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />
        <activity android:name="com.application.watch.classschedule.FastActivateActivity"
            android:exported="true"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />
        <activity android:name="com.application.watch.classschedule.HomepageSettingsActivity"
            android:exported="true"
            android:windowSoftInputMode="stateAlwaysHidden" />
        <activity android:name="com.application.watch.classschedule.DonateActivity"
            android:exported="true"
            android:windowSoftInputMode="stateAlwaysHidden" />
        <activity android:name="com.application.watch.classschedule.BatteryGuideActivity"
            android:exported="true"
            android:windowSoftInputMode="stateAlwaysHidden" />
        <activity android:name="com.application.watch.classschedule.ThemePickerActivity"
            android:exported="true"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <service
            android:name="com.application.watch.classschedule.SyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 桌面插件：今日课程（4×2） / 下一节课（4×1）。
             数据来自本地课表缓存（CourseCache），App 更新课表时主动刷新，
             另有系统级 30 分钟周期刷新（updatePeriodMillis）。 -->
        <receiver
            android:name="com.application.watch.classschedule.TodayWidgetProvider"
            android:exported="false"
            android:label="今日课程">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>
        <receiver
            android:name="com.application.watch.classschedule.NextWidgetProvider"
            android:exported="false"
            android:label="下一节课">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next_info" />
        </receiver>

        <!-- 上课提醒：闹钟触发 + 开机/应用更新后补排（闹钟不跨重启存活） -->
        <receiver
            android:name="com.application.watch.classschedule.ReminderReceiver"
            android:exported="false" />
        <receiver
            android:name="com.application.watch.classschedule.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
