# ============ 构建产物 ============
apk/out/
apk/dist/
# out.bak 是 apk/out/ 的历史备份（4.2MB / 502 文件），构建重新生成，不入库。
# 注意：它未 ignore 时会把整批待提交真代码一起"卡住"（禁 git add -A 时最省事的停摆点）。
apk/out.bak/
# 固定路径的最新包（apk/dist/ 已整目录忽略；这里覆盖多变体的根目录副本）
apk/*Probe.apk
apk/tools/bcclasses/
*.idsig

# ============ 密钥：绝不入库 ============
# ⚠️ 这些是签名私钥，一旦推上去就等于把发布权交出去
apk/keystore.jks
apk/rpk-signing-key.pk8
*.jks
*.keystore
*.pk8
*.p12
private.pem
certificate.pem
/sign/

# ============ 体积大 / 可重新下载 ============
# bcprov.jar 由 build.sh 自动从 Maven Central 下载（8 MB）
apk/tools/bcprov.jar
# AAR 解包产物（原始 AAR 在 tools/libs/ 里保留）
tools/libs/xms_aar/
tools/libs/xms_classes/
tools/*.zip

# ============ 系统 ============
.DS_Store
**/.DS_Store

# ============ 会话实验/临时（2026-10-02 收纳入库时划定） ============
.trae/
**/__pycache__/
# band-ble 实验目录只收两个脚本，venv 不入库
band-ble/bin/
band-ble/include/
band-ble/lib/
band-ble/pyvenv.cfg
# bandauth 探针的构建产物与日志
bandauth/out/
bandauth/dist/
bandauth/logs/
bandauth/*.apk

# ============ AI 工作记忆 / IDE 会话数据（本地保留，不入库） ============
# 注意：只挡 memory/ 与 plans/；.codebuddy/rules/ 是团队共享的项目规则，三仓统一入库。
.codebuddy/memory/
.codebuddy/plans/
